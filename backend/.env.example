SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/heymimic
SPRING_DATASOURCE_USERNAME=heymimic
SPRING_DATASOURCE_PASSWORD=replace_me
APP_ALLOWED_ORIGINS=http://localhost:5173
# Keep metrics behind a private operations ingress when enabled.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
QUEUE_METRICS_ENABLED=true
QUEUE_METRICS_INTERVAL=PT30S
QUEUE_METRICS_INITIAL_DELAY=PT5S
SECURITY_JWT_ISSUER=heymimic
SECURITY_JWT_AUDIENCE=heymimic-web
# Required in prod: Base64 DER (PKCS#8 private key and X.509 public key).
SECURITY_JWT_PRIVATE_KEY=
SECURITY_JWT_PUBLIC_KEY=
REVIEW_SESSION_CLEANUP_ENABLED=true
REVIEW_SESSION_CLEANUP_INTERVAL=PT15M
REVIEW_SESSION_INACTIVITY_TIMEOUT=PT24H
REVIEW_SESSION_CLEANUP_BATCH_SIZE=100
SPEAKING_FAKE_STORAGE=false
SPEAKING_FAKE_EVALUATION=false
SPEAKING_AUDIO_RETENTION_CLEANUP_ENABLED=true
SPEAKING_AUDIO_RETENTION_CLEANUP_INTERVAL=PT1H
SPEAKING_AUDIO_RETENTION_CLEANUP_BATCH_SIZE=100

# Auth email delivery. Dev/test use the in-memory sender.
IDENTITY_EMAIL_PROVIDER=in-memory
RESEND_API_KEY=
IDENTITY_EMAIL_FROM=
PUBLIC_APP_URL=http://localhost:5173
RESEND_API_BASE_URL=https://api.resend.com
IDENTITY_EMAIL_REQUEST_TIMEOUT=PT10S
# Claude provider. Staging/prod use AI_PROVIDER=anthropic.
AI_PROVIDER=in-memory
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
AI_REQUEST_TIMEOUT=PT30S
AI_MAX_OUTPUT_TOKENS=1200
AI_PROMPT_VERSION=claude-speaking-feedback-v1
AI_RUBRIC_VERSION=general-speaking-v1
# Versioned private audio storage. Staging/prod use AUDIO_STORAGE_PROVIDER=s3.
AUDIO_STORAGE_PROVIDER=s3
AUDIO_S3_BUCKET=
AWS_REGION=
AUDIO_S3_ENDPOINT=
AUDIO_S3_PATH_STYLE=false
AUDIO_S3_REQUEST_TIMEOUT=PT15S
AUDIO_UPLOAD_TTL=PT10M
AUDIO_PLAYBACK_TTL=PT1M
AUDIO_MAX_OBJECT_BYTES=20971520
FFPROBE_COMMAND=ffprobe
FFPROBE_TIMEOUT=PT10S
# Deepgram prerecorded transcription. Staging/prod require a server-side key.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
DEEPGRAM_API_BASE_URL=https://api.deepgram.com
STT_REQUEST_TIMEOUT=PT30S
# Global provider budget. Keep disabled until real staging rate-card values are verified.
PROVIDER_BUDGET_ENABLED=false
PROVIDER_BUDGET_DAILY_LIMIT_MICROS=0
PROVIDER_BUDGET_RATE_CARD_VERSION=alpha-2026-09
PROVIDER_BUDGET_SPEAKING_STT_MICROS=0
PROVIDER_BUDGET_SPEAKING_FEEDBACK_MICROS=0
PROVIDER_BUDGET_CONTEXT_EXTRACTION_MICROS=0
PROVIDER_RATE_INPUT_MICROS_PER_MILLION=0
PROVIDER_RATE_OUTPUT_MICROS_PER_MILLION=0
PROVIDER_RATE_AUDIO_MICROS_PER_MINUTE=0
PROVIDER_RATE_CHARACTER_MICROS_PER_THOUSAND=0

# RabbitMQ/Redis transport. These are process environment values, not auto-loaded dotenv.
# Alternatively run with SPRING_PROFILES_ACTIVE=dev,mq for local Compose defaults.
MESSAGING_TRANSPORT=postgres
JOBS_ENABLED=true
EVENTS_ENABLED=true
DISPATCH_RELAY_ENABLED=true
# Omit WORKER_ID to generate a process-unique UUID on every boot.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=heymimic
RABBITMQ_PASSWORD=replace_me
RABBITMQ_VHOST=heymimic
RABBITMQ_HEALTH_ENABLED=false
CACHE_ENABLED=false
CACHE_NAMESPACE=heymimic_dev
CATALOG_CACHE_REVISION=1
DAILY_PLAN_REFRESH_ENABLED=false
DAILY_PLAN_REFRESH_INTERVAL=1s
DAILY_PLAN_REFRESH_BATCH_SIZE=100
# Optional dedicated planning listener controls (Spring relaxed binding).
HEYMIMIC_MESSAGING_WORKLOADS_PLANNING=true
HEYMIMIC_MESSAGING_CONCURRENCY_PLANNING=1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
